//
// Runs in the data daemon, so a panic ends datad and init starts it again. The three lint
// properties switch the lint wall of lib.rs on in the platform build, see crates/wire/Android.bp.
rust_library {
    name: "libdataos_qmi",
    defaults: ["diamaneos_datad_defaults"],
    vendor: true,
    crate_name: "dataos_qmi",
    srcs: ["src/lib.rs"],
    edition: "2021",
    clippy_lints: "android",
    lints: "vendor",
    cargo_env_compat: true,
}
