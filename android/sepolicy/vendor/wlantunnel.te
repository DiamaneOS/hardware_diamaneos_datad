# The Wi-Fi tunnel daemon domain. The device includes it through datad-board.mk.
# Every rule below is exact: a permission is here because the code does the call, and the code is named. What stock
# nicmd did for Wi-Fi calling with netd and the connectivity service is not done here: no Binder, no use of
# netutils, no NET_RAW, no write to ip_local_reserved_ports. A port is held by a bound socket instead.
type diamaneos_wlantunnel, domain;
type diamaneos_wlantunnel_exec, exec_type, vendor_file_type, file_type;
type diamaneos_wlantunnel_state, file_type;
init_daemon_domain(diamaneos_wlantunnel)

# QMI to the modem over QRTR (WDS and DFS): one socket per client, as the data daemon does it. QRTR has no
# per-service access control, so qrtr.te of the device names this domain.
# socket, getsockname (the node of the machine, and the port after the bind), bind, sendto, recvmsg.
allow diamaneos_wlantunnel self:qipcrtr_socket { create bind getattr read write };

# The ESP states and policies the modem names (sys.rs). socket, bind, setsockopt (SO_RCVTIMEO and NETLINK_CAP_ACK),
# send and recv, and the type of message. No GETSA: a state is removed by its exact identifier, so this domain never
# sees the states of another one. Kernels from 6.13 check the type (policycap netlink_xperm).
allow diamaneos_wlantunnel self:netlink_xfrm_socket { create bind setopt read write nlmsg };
allowxperm diamaneos_wlantunnel self:netlink_xfrm_socket nlmsg { XFRM_MSG_NEWSA XFRM_MSG_DELSA XFRM_MSG_NEWPOLICY XFRM_MSG_DELPOLICY };

# The commands of rmnet_wlan and the lookup of its family (sys.rs). socket, bind, setsockopt (SO_RCVTIMEO), send, recv.
allow diamaneos_wlantunnel self:netlink_generic_socket { create bind setopt read write };

# The route socket: reverse links (create, and up and down, both RTM_NEWLINK), the addresses that tell which interface
# has a tunnel's local address (RTM_GETADDR, a dump) and the mark rule. The ioctls are the name to index and back. A test in crates/wlantunneld holds the message types to the code.
allow diamaneos_wlantunnel self:netlink_route_socket { create bind setopt read write ioctl nlmsg };
allowxperm diamaneos_wlantunnel self:netlink_route_socket nlmsg { RTM_NEWLINK RTM_GETADDR RTM_NEWRULE RTM_DELRULE };
allowxperm diamaneos_wlantunnel self:netlink_route_socket ioctl { SIOCGIFINDEX SIOCGIFNAME };
# Looking up an interface name that does not exist makes the kernel try to load a module for it, as for the data daemon.
dontaudit diamaneos_wlantunnel kernel:system module_request;

# The sockets that hold ports for the modem, and the UDP socket of a tunnel. socket, setsockopt (IPV6_V6ONLY,
# SO_REUSEPORT and UDP_ENCAP), bind, getsockname (the port the kernel picked). No data is read or written by this
# process, the kernel takes ESP off the UDP socket. connect is for the UDP socket only. TCP sockets are bound and
# never listen. Android has no port labels (port_contexts is empty), so every port is `port`.
allow diamaneos_wlantunnel self:udp_socket { create setopt bind getattr connect };
allow diamaneos_wlantunnel self:tcp_socket { create setopt bind getattr };
# connect in bionic goes through libnetd_client, which asks for SO_DOMAIN to see if it should mark the socket. Without
# this the socket goes unmarked, which is what the tunnel wants: the mark of its packets comes from the ESP state.
dontaudit diamaneos_wlantunnel self:udp_socket getopt;
allow diamaneos_wlantunnel node:{ udp_socket tcp_socket } node_bind;
allow diamaneos_wlantunnel port:{ udp_socket tcp_socket } name_bind;

allow diamaneos_wlantunnel self:capability net_admin;
neverallow diamaneos_wlantunnel self:capability ~net_admin;
neverallow diamaneos_wlantunnel self:capability2 *;
neverallow diamaneos_wlantunnel self:{ rawip_socket packet_socket tipc_socket } *;
neverallow diamaneos_wlantunnel self:tcp_socket { connect listen accept read write };
neverallow diamaneos_wlantunnel self:udp_socket { read write };

# dad_transmits, autoconf and accept_ra of /proc/sys/net/ipv6/conf/r_rmnet_data* (set_reverse_sysctls), opened
# for writing without truncation. A genfscon prefix label (genfs_contexts) keeps this to the reverse links.
# proc_net_type is what netd's rule for the /proc/sys/net files is written against.
type proc_net_r_rmnet_ipv6, fs_type, proc_type, proc_net_type;
allow diamaneos_wlantunnel proc_net_r_rmnet_ipv6:file { open write };
allow diamaneos_wlantunnel proc_net_r_rmnet_ipv6:dir search;
allow diamaneos_wlantunnel proc_net:dir search;

# The state file and the status file are in a tmpfs directory that init makes (wlantunneld.rc), written under a
# temporary name that a rename puts in place. Reading is open and read, and the standard library asks for the size.
allow diamaneos_wlantunnel diamaneos_wlantunnel_state:dir { search write add_name remove_name };
allow diamaneos_wlantunnel diamaneos_wlantunnel_state:file { create open read write getattr rename unlink };
# Only this domain writes its state: a state file that names another domain's tunnels would have them removed at the
# next start. The file names tunnels, so nobody else reads it either. vendor_init runs the mkdir of the rc file and
# sets the owner and mode. init and dumpstate are named where the platform grants them access.
allow vendor_init diamaneos_wlantunnel_state:dir { create setattr getattr };
neverallow { domain -diamaneos_wlantunnel -init -vendor_init } diamaneos_wlantunnel_state:dir { write add_name remove_name setattr rename reparent rmdir };
neverallow { domain -diamaneos_wlantunnel -init -vendor_init } diamaneos_wlantunnel_state:file { write create append rename setattr unlink link };
neverallow { domain -diamaneos_wlantunnel -init -vendor_init -dumpstate } diamaneos_wlantunnel_state:dir { read open ioctl lock };
neverallow { domain -diamaneos_wlantunnel -init -vendor_init -dumpstate } diamaneos_wlantunnel_state:file { read open map ioctl lock };
